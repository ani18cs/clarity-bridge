# ==========================================
# ClarityBridge — Environment Variables Template
# NEVER commit the real .env file with real secrets!
# ==========================================

# Port & Server Environment
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-clarity-bridge-uploads-bucket
GCP_LOCATION=us-central1

# Google Gemini API / Vertex AI
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: GEMINI_MODEL=gemini-2.5-flash

# Google Custom Search API & Programmable Search Engine
CUSTOM_SEARCH_API_KEY=your-custom-search-api-key-here
CUSTOM_SEARCH_ENGINE_ID=your-search-engine-cx-id-here

# Firebase Admin SDK Configuration (Backend)
# For local development with service account credentials:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Or inline JSON:
# FIREBASE_CONFIG_JSON={"type":"service_account",...}

# Firebase Web Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_API_BASE_URL=http://localhost:8080/api
