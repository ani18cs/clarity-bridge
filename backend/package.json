{
  "name": "clarity-bridge-backend",
  "version": "1.0.0",
  "description": "Backend API for ClarityBridge — Document Understanding, Fraud Detection, and Action Planning",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "5.6.0",
    "@google-cloud/speech": "6.7.0",
    "@google-cloud/storage": "7.15.0",
    "@google-cloud/text-to-speech": "5.8.0",
    "@google-cloud/vertexai": "1.9.0",
    "@google/generative-ai": "0.24.0",
    "axios": "1.7.9",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "8.7.0",
    "firebase-admin": "13.1.0",
    "helmet": "8.0.0",
    "multer": "1.4.5-lts.1",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "puppeteer": "^25.10.0",
    "tesseract.js": "7.0.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
